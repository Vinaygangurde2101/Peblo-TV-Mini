# Database Configuration
POSTGRES_USER=peblo_admin
POSTGRES_PASSWORD=peblo_secret_pass
POSTGRES_DB=peblo_tv_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://peblo_admin:peblo_secret_pass@postgres:5432/peblo_tv_db

# Security & JWT
SECRET_KEY=super-secret-development-key-change-in-production-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage Config
STORAGE_TYPE=local
STORAGE_PATH=/app/storage
CATALOGUE_PATH=/app/storage/catalogue.json

# Public / API URLs
API_URL=http://localhost:8000
CMS_URL=http://localhost:3000
VIEWER_URL=http://localhost:3001
